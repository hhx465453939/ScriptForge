# 运行时产物（不入库）

__pycache__/
*.py[cod]
*$py.class

# 抓取与检索缓存
cache/
guji-cache/

# 运行日志（脚本侧）
logs/
scripts/**/*.log
tests/**/*.log
# 说明：只忽略脚本/测试的运行日志；抓取缓存与 pycache 另有条目
# 说明：tasks/CHG-*/verify.log 是验收证据，故意不忽略

# 运营物料包（使用者本地产出 / 私域内容，不入库）
# 原因：campaigns/ 是使用者用 campaign_init.py 生成的战役物料，属于使用者的运营工作，
#       不是项目源码。台子在 references/ + assets/ + scripts/，不在战役产物里。
campaigns/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
